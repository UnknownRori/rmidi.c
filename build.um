import "umb.um"

CC := "clang"

fn build_lib_rmidi*(b: ^umb::Build, kind: int): ^umb::Library {
    return b.createLibrary({
        name                : "rmidi",
        cc                  : CC,
        kind                : kind,
        sources             : []str{
            "rmidi.c",
        },
        include_directories : []str{".", "./external/rstb"},
    })
}

fn build(b: ^umb::Build) {
    rmidi := build_lib_rmidi(b, umb::LIB_STATIC)

    exe   := b.createExecutable({
        name               : "main",
        cc                 : CC,
        sources            : []str{"main.c"},
        include_directories: []str{".", "./external/rstb"},
    })

    build := b.step("build", "Build the app")
    build.dependsOn(exe)

    run := b.step("run", "Run the app")
    run.dependsOn(exe)
    run.addCommand(exe.output())
}

